<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<TabPane maxHeight="Infinity"
         maxWidth="Infinity"
         prefHeight="430.0"
         prefWidth="750.0"
         tabClosingPolicy="UNAVAILABLE"
         xmlns="http://javafx.com/javafx/8.0.171"
         xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="extension.Plants">

   <tabs>

      <Tab text="Home">
         <content>
            <VBox maxHeight="Infinity"
                  maxWidth="Infinity"
                  spacing="10.0">

               <padding>
                  <Insets bottom="15.0"
                          left="15.0"
                          right="15.0"
                          top="15.0" />
               </padding>

               <children>

                  <HBox spacing="10.0" VBox.vgrow="ALWAYS">
                     <children>

                        <VBox spacing="4.0"
                              prefWidth="170.0"
                              style="-fx-border-color: lightgrey; -fx-border-width: 1px; -fx-border-radius: 5px; -fx-padding: 8;">
                           <children>
                              <Label text="State"
                                     style="-fx-font-size: 12px; -fx-font-weight: bold;" />
                              <Label fx:id="connectedLbl"
                                     text="Not connected"
                                     alignment="CENTER"
                                     maxWidth="Infinity"
                                     style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 4 10; -fx-background-radius: 4;" />
                               <Label fx:id="roomLbl"
                                      text="Room Not Loaded"
                                      alignment="CENTER"
                                      maxWidth="Infinity"
                                      style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 4 10; -fx-background-radius: 4;" />
                               <Label fx:id="furniDataStateLbl"
                                      text="Furni Data Not Loaded"
                                      alignment="CENTER"
                                      maxWidth="Infinity"
                                      style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 4 10; -fx-background-radius: 4;" />
                               <Button text="Reload Furni Data"
                                       onAction="#onRequestFurniData"
                                       maxWidth="Infinity"
                                       prefHeight="25.0" />
                           </children>
                        </VBox>

                        <VBox fx:id="commandsBox"
                              spacing="0.0"
                              style="-fx-border-color: lightgrey; -fx-border-width: 1px; -fx-border-radius: 5px; -fx-padding: 1;"
                              VBox.vgrow="ALWAYS"
                              HBox.hgrow="ALWAYS">
                           <children>
                              <Label fx:id="lblAvailableCommands"
                                     text="Available commands:"
                                     style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 4 6;" />
                           </children>
                        </VBox>

                     </children>
                  </HBox>

               </children>

            </VBox>
         </content>
      </Tab>

      <Tab text="Logs">
         <content>

            <VBox maxHeight="Infinity"
                  maxWidth="Infinity"
                  spacing="10.0">

               <padding>
                  <Insets bottom="15.0"
                          left="15.0"
                          right="15.0"
                          top="15.0" />
               </padding>

               <children>

                  <TextArea fx:id="logArea"
                            editable="false"
                            maxHeight="Infinity"
                            maxWidth="Infinity"
                            prefHeight="340.0"
                            wrapText="true"
                            style="-fx-font-size: 11px; -fx-font-family: monospace;"
                            VBox.vgrow="ALWAYS" />

                  <HBox spacing="10.0"
                         alignment="CENTER_LEFT">

                     <children>

                        <Label text="Log level:"
                               style="-fx-padding: 2 0 2 0;" />

                        <ComboBox fx:id="logLevelCombo"
                                  prefWidth="140.0"
                                  style="-fx-border-color:#000000; -fx-border-width:1; -fx-background-color:#ffffff; -fx-text-fill:#000000;" />

                        <Region HBox.hgrow="ALWAYS" />

                        <Button text="Clear logs"
                                onAction="#clearLogs" />

                     </children>

                  </HBox>

               </children>

            </VBox>

         </content>
      </Tab>

      <Tab text="Settings">
         <content>

            <VBox maxHeight="Infinity"
                  maxWidth="Infinity"
                  spacing="5.0">

               <padding>
                  <Insets bottom="15.0"
                          left="15.0"
                          right="15.0"
                          top="15.0" />
               </padding>

               <children>

                  <!-- Advanced options -->
                  <Label text="Advanced options"
                         style="-fx-font-size: 14px; -fx-font-weight: bold;" />

                  <VBox spacing="8.0">
                     <children>
                        <HBox spacing="4.0" alignment="CENTER_LEFT">
                           <children>
                              <CheckBox fx:id="chkRequestPetInfo"
                                        selected="true"
                                        text="Request Plant info before treating plant"
                                        minHeight="-Infinity"
                                        style="-fx-padding: 2 4 2 4;" />
                              <Button fx:id="btnPetInfoHelp"
                                      text="(?)"
                                      mnemonicParsing="false"
                                      style="-fx-font-weight: bold; -fx-text-fill: #2b7df6; -fx-background-color: transparent; -fx-border-color: transparent; -fx-border-width: 0; -fx-background-insets: 0; -fx-border-insets: 0; -fx-padding: 0; -fx-focus-color: transparent; -fx-faint-focus-color: transparent; -fx-cursor: hand;" />
                           </children>
                        </HBox>
                        <CheckBox fx:id="loadFurniDataOnlyWhenNeeded"
                                  text="Load furni data only when needed"
                                  minHeight="-Infinity"
                                  style="-fx-padding: 2 4 2 4;" />
                     </children>
                  </VBox>

                  <Region prefHeight="2.0" />

                  <!-- Auto-accept breeding -->
                  <Label text="Auto-accept breeding"
                         style="-fx-font-size: 14px; -fx-font-weight: bold;" />

                   <VBox spacing="8.0">
                      <children>
                         <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <children>
                               <CheckBox fx:id="chkAutoBreed"
                                         text="Enable auto-accept breeding from"
                                         minHeight="-Infinity"
                                         style="-fx-padding: 2 4 2 4;" />
                               <ComboBox fx:id="cmbAutoBreedAcceptMode"
                                         prefWidth="160.0"
                                         prefHeight="25.0"
                                         style="-fx-border-color:#000000; -fx-border-width:1; -fx-background-color:#ffffff; -fx-text-fill:#000000;" />
                            </children>
                         </HBox>
                         <CheckBox fx:id="chkAutoBreedRequireSameOrHigherRarity"
                                   text="Auto accept only if rarity level is same level or higher"
                                   selected="true"
                                   minHeight="-Infinity"
                                   style="-fx-padding: 2 4 2 4;" />
                      </children>
                   </VBox>

                  <HBox spacing="8.0"
                         alignment="CENTER_LEFT">

                     <children>

                        <TextField fx:id="txtAutoBreedUsername"
                                   promptText="Username"
                                   HBox.hgrow="ALWAYS" />

                        <Button fx:id="btnAutoBreedAdd"
                                text="Add"
                                minHeight="-Infinity"
                                style="-fx-padding: 2 4 2 4;" />

                        <Button fx:id="btnAutoBreedRemove"
                                text="Remove checked"
                                minHeight="-Infinity"
                                style="-fx-padding: 2 4 2 4;" />

                     </children>

                  </HBox>

                  <Label text="Trusted users"
                         style="-fx-font-weight: bold;" />

                  <TableView fx:id="tblAutoBreedUsers"
                             editable="true"
                             fixedCellSize="30.0"
                             style="-fx-cell-size: 30px;"
                             prefHeight="150.0"
                             VBox.vgrow="ALWAYS">
                      <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                  </TableView>

               </children>

            </VBox>

         </content>
      </Tab>

   </tabs>

</TabPane>